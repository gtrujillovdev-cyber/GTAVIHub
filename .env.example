# Gemini / Hydrogen API Configuration (Google AI Studio)
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_FALLBACK_MODELS=gemini-4-hydrogen,gemini-2.5-flash,gemini-2.5-flash-lite

# Directorios de trabajo
OUTPUT_DIR=./output
TEMP_DIR=./temp

# Parámetros de ejecución
MAX_VIDEOS_PER_RUN=1
LAUNCH_MAX_DAILY_UPLOADS=4
FORCE_ENABLE_GAMEPLAY=true
MAX_DAILY_UPLOADS_YOUTUBE=4
MAX_DAILY_UPLOADS_TIKTOK=4
MAX_DAILY_UPLOADS_INSTAGRAM=3
DEFAULT_TTS_VOICE=es-ES-AlvaroNeural
YOUTUBE_PRIVACY_STATUS=public

# Automatización de Navegador (MacBook Pro Headless)
HEADLESS_BROWSER=false

# Bot de Control Remoto y Alertas de Telegram (Opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Monetización, Afiliados y Contacto Comercial Público
BUSINESS_EMAIL=gtavihubspain.business@gmail.com
MONETIZATION_AFFILIATE_URL=https://linktr.ee/gtavihubextra
ENABLE_AUTO_PINNED_COMMENT=true

# Mejoras Retención & Sincronía ($0 + Rollback Instantáneo)
GROQ_API_KEY=
ENABLE_GROQ_SYNC=true
TTS_RATE=+14%
TTS_PITCH=+2Hz
ENABLE_VOICE_ENHANCER=true
ENABLE_FOLLOW_CTA=true
FOLLOW_CTA_TEXT=➕ SIGUE PARA + SECRETOS DE LEONIDA
ENABLE_PROGRESS_BAR=true
