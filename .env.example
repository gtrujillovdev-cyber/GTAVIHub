# Gemini API Configuration (Google AI Studio)
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-2.5-flash

# Directorios de trabajo
OUTPUT_DIR=./output
TEMP_DIR=./temp

# Parámetros de ejecución
MAX_VIDEOS_PER_RUN=1
MAX_DAILY_UPLOADS_YOUTUBE=4
MAX_DAILY_UPLOADS_TIKTOK=4
MAX_DAILY_UPLOADS_INSTAGRAM=3
DEFAULT_TTS_VOICE=es-ES-AlvaroNeural
YOUTUBE_PRIVACY_STATUS=public

# Automatización de Navegador (MacBook Pro Headless)
HEADLESS_BROWSER=false

# Bot de Control Remoto y Alertas de Telegram (Opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Monetización, Afiliados y Contacto Comercial Público
BUSINESS_EMAIL=gtavihubspain.business@gmail.com
MONETIZATION_AFFILIATE_URL=https://linktr.ee/gtavihubspain
ENABLE_AUTO_PINNED_COMMENT=true
